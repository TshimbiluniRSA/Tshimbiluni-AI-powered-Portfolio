# Backend Configuration
# Copy this file to .env and fill in your actual values

# Application Settings
APP_NAME=Tshimbiluni AI-powered Portfolio
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./portfolio.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/portfolio
# For MySQL: mysql+aiomysql://user:password@localhost:3306/portfolio

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true

# OpenAI Responses API Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_MAX_OUTPUT_TOKENS=800
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_SECONDS=60
OPENAI_CONTEXT_MESSAGE_LIMIT=10
# Backward-compatible fallback when OPENAI_MAX_OUTPUT_TOKENS is unset
MAX_TOKENS=800
TEMPERATURE=0.7

# GitHub API Configuration
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_API_URL=https://api.github.com

# LinkedIn Scraping Configuration
# Note: LinkedIn scraping requires proper authentication and may be against ToS
LINKEDIN_EMAIL=your_linkedin_email@example.com
LINKEDIN_PASSWORD=your_linkedin_password_here
USE_LINKEDIN_SCRAPING=false

# Session Configuration
SESSION_SECRET_KEY=your_secret_key_here_min_32_characters_long
SESSION_EXPIRE_MINUTES=1440

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Cache Configuration
CACHE_TYPE=memory
CACHE_TTL_SECONDS=3600
REDIS_URL=redis://localhost:6379/0

# Monitoring & Analytics
ENABLE_METRICS=true
SENTRY_DSN=your_sentry_dsn_here_optional

# Feature Flags
ENABLE_CHAT=true
ENABLE_GITHUB_SYNC=true
ENABLE_LINKEDIN_SYNC=false
ENABLE_STREAMING=true

# Security
API_KEY_HEADER=X-API-Key
API_KEYS=your_api_key_1,your_api_key_2
